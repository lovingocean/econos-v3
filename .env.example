# GEMINI_API_KEY: Required for Gemini AI Advisor & sovereign economic intelligence calls.
# Kept strictly server-side; never exposed to browser client.
GEMINI_API_KEY=""

# APPLICATION_URL / APP_URL: Production domain URL (e.g., https://your-econos-app.vercel.app)
# Used for webhook verification, return redirects, and absolute callback routing.
APPLICATION_URL=""
APP_URL=""

# AUTH_SECRET: Cryptographic secret key for signing session tokens and tenant security context.
AUTH_SECRET=""

# STRIPE_SECRET_KEY: Server-side secret key for Stripe/payment processing gateway.
# Used for server-side customer creation and checkout session initialization.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Secret for HMAC SHA-256 signature verification of incoming billing webhooks.
STRIPE_WEBHOOK_SECRET=""

# DATABASE_URL / DATABASE_PATH: Target persistence path or connection string.
# On Vercel, defaults automatically to /tmp/econos-database.json if unconfigured.
DATABASE_URL=""
DATABASE_PATH=""

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins in production.
# Example: https://econos.vercel.app,https://app.econos.ai
ALLOWED_ORIGINS=""

# NODE_ENV: Runtime environment (production / development)
NODE_ENV="production"

